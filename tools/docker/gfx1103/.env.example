# Settings for compose.yaml. In Dockhand paste these into the stack's environment; with plain compose copy to .env.
# Paths in MODEL / VISION / TOKENIZER are as seen INSIDE the container: MODELS_DIR is mounted at /models.

# the image built with: docker build -t strata-780m:0.1.67 -f tools/docker/gfx1103/Dockerfile .
STRATA_IMAGE=strata-780m:0.1.67

# where it listens on the host: 127.0.0.1 = this PC only; 0.0.0.0 = other devices too (set API_KEY then)
BIND=127.0.0.1
PORT=8090

# the model
MODELS_DIR=/opt/llm_models
MODEL=/models/Strata/models/inkling-2-mini/Inkling-2-Mini-SQ-15.strata
# MODEL=/models/Strata/models/inkling-2-mini/Inkling-2-Mini-SQ-10.strata
# MODEL=/models/Inkling-2-Mini-GGUF/Inkling-2-Mini-UD-Q4_K_XL.gguf        # with VISION set to the Strata vision file below
VISION=auto
# VISION=/models/Strata/models/inkling-2-mini/Inkling-2-Mini-Vision.strata
MODEL_NAME=

# serving
CONTEXT=128k
PARALLEL=1
DRAFTING=off
API_KEY=

# hardware (this PC: the 780M is HIP device 0; ROCm skips the WX 7100)
GPU=0
VIDEO_GID=39
RENDER_GID=105
HIPBLASLT_TABLE=on        # no effect on Inkling-2-Mini: only the Qwen engine reads this table

# advanced
TOKENIZER=
TOKENIZER_SOURCE=
ENGINE_ARGS=
SERVER_ARGS=
